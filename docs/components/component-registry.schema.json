{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/component-registry/v1",
  "title": "QtMaterial3 component registry",
  "description": "Version 1 schema for docs/components/component-registry.json. The on-disk registry remains a JSON array; schema evolution is versioned independently.",
  "x-qtm3-schemaVersion": 1,
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "family",
      "maturity",
      "maturityPolicy",
      "publicHeader",
      "specType",
      "widgetType",
      "testTarget",
      "galleryRoute",
      "docsPath",
      "releaseScope",
      "referenceCandidate",
      "maturityAxes"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "family": {
        "type": "string",
        "minLength": 1
      },
      "maturity": {
        "enum": [
          "complete",
          "usable",
          "partial",
          "skeleton",
          "planned"
        ]
      },
      "maturityPolicy": {
        "enum": [
          "manual",
          "derived"
        ]
      },
      "publicHeader": {
        "type": "string",
        "pattern": "^qtmaterial/widgets/.+\\.h$"
      },
      "specType": {
        "type": "string",
        "minLength": 1
      },
      "widgetType": {
        "type": "string",
        "minLength": 1
      },
      "testTarget": {
        "type": "string"
      },
      "galleryRoute": {
        "type": "string",
        "pattern": "^/"
      },
      "docsPath": {
        "type": "string",
        "pattern": "^docs/"
      },
      "releaseScope": {
        "type": "boolean"
      },
      "referenceCandidate": {
        "type": "boolean"
      },
      "maturityAxes": {
        "type": "object",
        "required": [
          "api",
          "rendering",
          "states",
          "accessibility",
          "keyboard",
          "hidpi",
          "rtl",
          "tests",
          "example",
          "docs",
          "lastReviewed",
          "gaps",
          "nextActions",
          "evidence"
        ],
        "properties": {
          "api": {
            "$ref": "#/$defs/axis"
          },
          "rendering": {
            "$ref": "#/$defs/axis"
          },
          "states": {
            "$ref": "#/$defs/axis"
          },
          "accessibility": {
            "$ref": "#/$defs/axis"
          },
          "keyboard": {
            "$ref": "#/$defs/axis"
          },
          "hidpi": {
            "$ref": "#/$defs/axis"
          },
          "rtl": {
            "$ref": "#/$defs/axis"
          },
          "tests": {
            "$ref": "#/$defs/axis"
          },
          "example": {
            "$ref": "#/$defs/axis"
          },
          "docs": {
            "$ref": "#/$defs/axis"
          },
          "lastReviewed": {
            "type": "string",
            "format": "date"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "nextActions": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "evidence": {
            "type": "object",
            "required": [
              "api",
              "rendering",
              "states",
              "accessibility",
              "keyboard",
              "hidpi",
              "rtl",
              "tests",
              "example",
              "docs"
            ],
            "properties": {
              "api": { "$ref": "#/$defs/evidence" },
              "rendering": { "$ref": "#/$defs/evidence" },
              "states": { "$ref": "#/$defs/evidence" },
              "accessibility": { "$ref": "#/$defs/evidence" },
              "keyboard": { "$ref": "#/$defs/evidence" },
              "hidpi": { "$ref": "#/$defs/evidence" },
              "rtl": { "$ref": "#/$defs/evidence" },
              "tests": { "$ref": "#/$defs/evidence" },
              "example": { "$ref": "#/$defs/evidence" },
              "docs": { "$ref": "#/$defs/evidence" },
              "notes": { "$ref": "#/$defs/evidence" }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": false
  },
  "$defs": {
    "axis": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        {
          "const": "N/A"
        }
      ]
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}

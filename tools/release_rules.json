{
  "schema_version": 1,
  "base": {
    "required_files": [
      "LICENSE",
      "README.md",
      "CHANGELOG.md",
      "ROADMAP.md",
      "CONTRIBUTING.md",
      "SECURITY.md",
      "packaging/QtMaterial3WidgetsConfig.cmake.in",

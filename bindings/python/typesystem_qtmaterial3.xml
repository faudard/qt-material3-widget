<?xml version="1.0"?>
<typesystem package="_QtMaterial3">
  <load-typesystem name="typesystem_widgets.xml" generate="no"/>

  <namespace-type name="QtMaterial">
    <enum-type name="ThemeMode"/>
    <enum-type name="ContrastMode"/>
    <enum-type name="ThemePreference"/>
    <enum-type name="ThemeVariant"/>
    <enum-type name="ColorBackendPolicy"/>
    <enum-type name="MotionScheme"/>
    <enum-type name="Density"/>
    <enum-type name="WindowWidthSizeClass"/>
    <enum-type name="WindowHeightSizeClass"/>
    <enum-type name="QtMaterialButtonSize"/>
    <enum-type name="QtMaterialButtonShape"/>
    <enum-type name="ChipVariant"/>
    <enum-type name="SnackbarDuration"/>
    <enum-type name="SnackbarDismissReason"/>
    <enum-type name="TabsVariant"/>
    <enum-type name="TabsDensity"/>
    <enum-type name="TabsAlignment"/>
    <enum-type name="TabsOverflowMode"/>

    <value-type name="WindowSizeClass"/>
    <value-type name="ThemeOptions"/>
    <value-type name="Theme"/>
    <value-type name="ThemeBuilder"/>
    <value-type name="QtMaterialRoute"/>
    <value-type name="QtMaterialNavigationItem"/>

    <object-type name="ThemeContext" delete-in-owner-thread="yes"/>
    <!-- ThemeContextHost is a non-QObject, pure C++ mix-in with a protected
         constructor. It is intentionally not a Python type: exposed widgets
         inherit their QObject/QWidget Python base and implement themeContext()
         directly. Shiboken 6.6.3 otherwise emits an invalid Py_tp_init. -->

    <object-type name="QtMaterialWidget" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="themeContext()const">
        <modify-argument index="return">
          <define-ownership class="target" owner="default"/>
        </modify-argument>
      </modify-function>
      <modify-function signature="effectiveThemeContext()const">
        <modify-argument index="return">
          <define-ownership class="target" owner="default"/>
        </modify-argument>
      </modify-function>
    </object-type>
    <object-type name="QtMaterialControl" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialSurface" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <!-- Host pointer is borrowed and tracked by C++ QPointer. -->
    <object-type name="QtMaterialOverlaySurface" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="hostWidget()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="setHostWidget(QWidget*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
    </object-type>
    <object-type name="QtMaterialAbstractButton" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="themeContext()const">
        <modify-argument index="return">
          <define-ownership class="target" owner="default"/>
        </modify-argument>
      </modify-function>
      <modify-function signature="effectiveThemeContext()const">
        <modify-argument index="return">
          <define-ownership class="target" owner="default"/>
        </modify-argument>
      </modify-function>
    </object-type>
    <object-type name="QtMaterialSelectionControl" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialFormFieldControl" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialInputControl" delete-in-main-thread="yes" disable-wrapper="yes"/>

    <object-type name="QtMaterialTextButton" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialFilledButton" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialOutlinedButton" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialFilledTonalButton" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialElevatedButton" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialCheckbox" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialRadioButton" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialSwitch" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialChip" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialTooltip" delete-in-main-thread="yes" disable-wrapper="yes">
      <enum-type name="Placement"/>
      <modify-function signature="targetWidget()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="setTargetWidget(QWidget*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
    </object-type>

    <object-type name="QtMaterialOutlinedTextField" delete-in-main-thread="yes" disable-wrapper="yes">
      <enum-type name="ValidationFeedbackMode"/>
      <enum-type name="RequiredValidationMode"/>
      <enum-type name="ErrorDisplayMode"/>
      <enum-type name="EndActionMode"/>
    </object-type>
    <object-type name="QtMaterialFilledTextField" delete-in-main-thread="yes" disable-wrapper="yes"/>

    <object-type name="QtMaterialCard" delete-in-main-thread="yes" disable-wrapper="yes">
      <enum-type name="Variant"/>
    </object-type>

    <!-- 1.17.5: only tested value/property-driven surfaces. -->
    <object-type name="QtMaterialDialog" delete-in-main-thread="yes" disable-wrapper="yes">
      <!-- Body replacement reparents/detaches widgets: future ownership gate. -->
      <modify-function signature="setBodyWidget(QWidget*)" remove="all"/>
      <modify-function signature="bodyWidget()const" remove="all"/>
      <modify-function signature="initialFocusWidget()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="setInitialFocusWidget(QWidget*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="defaultButton()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="setDefaultButton(QAbstractButton*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
    </object-type>
    <object-type name="QtMaterialSnackbar" delete-in-main-thread="yes" disable-wrapper="yes">
      <!-- Request payload/queue contracts remain outside this catalogue. -->
      <modify-function signature="setRequest(const SnackbarRequest&amp;)" remove="all"/>
      <modify-function signature="request()const" remove="all"/>
    </object-type>
    <object-type name="QtMaterialBadge" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialPagination" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="spec()const" remove="all"/>
      <modify-function signature="setSpec(const PaginationSpec&amp;)" remove="all"/>
      <modify-function signature="themeContext()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="effectiveThemeContext()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="setThemeContext(ThemeContext*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
    </object-type>
    <object-type name="QtMaterialDivider" delete-in-main-thread="yes" disable-wrapper="yes">
      <!-- Static factories allocate widgets; defer their return ownership gate. -->
      <modify-function signature="horizontal(QWidget*)" remove="all"/>
      <modify-function signature="vertical(QWidget*)" remove="all"/>
    </object-type>

    <object-type name="QtMaterialNavigationBar" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialNavigationRail" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialNavigationModel" delete-in-main-thread="yes" disable-wrapper="yes">
      <enum-type name="Role"/>
    </object-type>
    <!-- Abstract navigation controller and concrete stacked-widget adapter:
         Python cannot instantiate the abstract interface; controllers and
         stacks stay externally owned and are tracked by C++ QPointer. -->
    <object-type name="QtMaterialNavigationController" delete-in-main-thread="yes" disable-wrapper="yes"/>
    <object-type name="QtMaterialStackedWidgetController" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="QtMaterialStackedWidgetController(QStackedWidget*,QObject*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="stackedWidget()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
    </object-type>
    <!-- Factories using std::function remain deferred; controllers are
         exposed with explicit non-owning pointer contracts. -->
    <object-type name="QtMaterialTabs" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="spec()const" remove="all"/>
      <modify-function signature="authoredSpec()const" remove="all"/>
      <modify-function signature="setSpec(const TabsSpec&amp;)" remove="all"/>
      <modify-function signature="setTabFactory(int,std::function&lt;QWidget*()>)" remove="all"/>
      <modify-function signature="setTabFactory(const QtMaterialRoute&amp;,std::function&lt;QWidget*()>)" remove="all"/>
      <!-- Tabs stores a non-owning QPointer to the navigation model. -->
      <modify-function signature="navigationModel()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="setNavigationModel(QtMaterialNavigationModel*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="bindToController(QtMaterialNavigationController*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="unbindController(QtMaterialNavigationController*)">
        <modify-argument index="1"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="boundControllers()const" remove="all"/>
      <modify-function signature="themeContext()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
      <modify-function signature="effectiveThemeContext()const">
        <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
      </modify-function>
    </object-type>

    <object-type name="QtMaterialLinearProgressIndicator" delete-in-main-thread="yes" disable-wrapper="yes">
      <enum-type name="Mode"/>
      <modify-function signature="asyncState()const" remove="all"/>
      <modify-function signature="setAsyncState(const QtMaterialAsyncState&amp;)" remove="all"/>
      <modify-function signature="spec()const" remove="all"/>
      <modify-function signature="setSpec(const ProgressIndicatorSpec&amp;)" remove="all"/>
    </object-type>
    <object-type name="QtMaterialCircularProgressIndicator" delete-in-main-thread="yes" disable-wrapper="yes">
      <modify-function signature="spec()const" remove="all"/>
      <modify-function signature="setSpec(const ProgressIndicatorSpec&amp;)" remove="all"/>
    </object-type>
    <object-type name="QtMaterialLoadingIndicator" delete-in-main-thread="yes" disable-wrapper="yes"/>
  </namespace-type>

  <!-- Unlike other widgets, QtMaterialMenu is in the global C++ namespace. -->
  <object-type name="QtMaterialMenu" delete-in-main-thread="yes" disable-wrapper="yes">
    <enum-type name="ItemRole"/>
    <modify-function signature="spec()const" remove="all"/>
    <modify-function signature="setSpec(const QtMaterial::MenuSpec&amp;)" remove="all"/>
    <modify-function signature="themeContext()const">
      <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
    </modify-function>
    <modify-function signature="effectiveThemeContext()const">
      <modify-argument index="return"><define-ownership class="target" owner="default"/></modify-argument>
    </modify-function>
  </object-type>
</typesystem>

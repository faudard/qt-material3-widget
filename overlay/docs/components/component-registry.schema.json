{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/component-registry/v1",
  "title": "QtMaterial3 component registry",
  "description": "Version 1 schema for docs/components/component-registry.json. The on-disk registry remains a JSON array; schema evolution is versioned independently.",
  "x-qtm3-schemaVersion": 1,
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "family",
      "maturity",
      "publicHeader",
      "specType",
      "widgetType",
      "galleryRoute",
      "docsPath"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
      },
      "name": {
        "type": "string",
        "minLength": 1
      },
      "family": {
        "type": "string",
        "minLength": 1
      },
      "maturity": {
        "enum": [
          "complete",
          "usable",
          "partial",
          "skeleton",
          "planned"
        ]
      },
      "maturityPolicy": {
        "enum": [
          "manual",
          "derived"
        ]
      },
      "publicHeader": {
        "type": "string",
        "pattern": "^qtmaterial/widgets/.+\\.h$"
      },
      "specType": {
        "type": "string",
        "minLength": 1
      },
      "widgetType": {
        "type": "string",
        "minLength": 1
      },
      "testTarget": {
        "type": "string"
      },
      "galleryRoute": {
        "type": "string",
        "pattern": "^/"
      },
      "docsPath": {
        "type": "string",
        "pattern": "^docs/"
      },
      "releaseScope": {
        "type": "boolean"
      },
      "referenceCandidate": {
        "type": "boolean"
      },
      "maturityAxes": {
        "type": "object",
        "properties": {
          "api": {
            "$ref": "#/$defs/axis"
          },
          "rendering": {
            "$ref": "#/$defs/axis"
          },
          "states": {
            "$ref": "#/$defs/axis"
          },
          "accessibility": {
            "$ref": "#/$defs/axis"
          },
          "keyboard": {
            "$ref": "#/$defs/axis"
          },
          "hidpi": {
            "$ref": "#/$defs/axis"
          },
          "rtl": {
            "$ref": "#/$defs/axis"
          },
          "tests": {
            "$ref": "#/$defs/axis"
          },
          "example": {
            "$ref": "#/$defs/axis"
          },
          "docs": {
            "$ref": "#/$defs/axis"
          },
          "lastReviewed": {
            "type": "string",
            "format": "date"
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "nextActions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "additionalProperties": true
  },
  "$defs": {
    "axis": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        {
          "const": "N/A"
        }
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/material-reference-suite/v1",
  "title": "QtMaterial3 Material Reference Suite",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profileId",
    "status",
    "family",
    "anchorComponentId",
    "caseDimensions",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9.-]+$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "seeded",
        "evidence-backed"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "anchorComponentId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "caseDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "components",
        "states",
        "themes"
      ],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "enabled",
              "disabled",
              "hovered",
              "focused",
              "pressed",
              "dragged",
              "selected",
              "unselected"
            ]
          }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": [
              "light",
              "dark"
            ]
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "componentId",
          "state",
          "theme",
          "classification",
          "assertions"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "componentId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "type": "string",
            "minLength": 1
          },
          "theme": {
            "enum": [
              "light",
              "dark"
            ]
          },
          "classification": {
            "enum": [
              "MUST_MATCH",
              "PLATFORM_ADAPTATION",
              "QTMATERIAL_EXTENSION"
            ]
          },
          "assertions": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/assertion"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "classification",
        "path",
        "operator",
        "expected",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "geometry",
            "tokens",
            "colors",
            "typography",
            "states",
            "motion",
            "accessibility",
            "behavior"
          ]
        },
        "classification": {
          "enum": [
            "MUST_MATCH",
            "PLATFORM_ADAPTATION",
            "QTMATERIAL_EXTENSION"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1
        },
        "operator": {
          "enum": [
            "equals",
            "approx",
            "token-equals",
            "range",
            "present",
            "absent"
          ]
        },
        "expected": {},
        "tolerance": {},
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        }
      }
    }
  }
}

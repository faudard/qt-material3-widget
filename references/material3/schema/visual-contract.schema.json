{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/material-visual-contract/v1",
  "title": "QtMaterial3 Material visual contract",
  "description": "Deterministic fixture, raster environment, target and reference inventory contract for Material visual conformance.",
  "x-qtm3-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profileId",
    "componentModelId",
    "status",
    "rendererSuiteIds",
    "fixture",
    "environment",
    "imageNormalization",
    "comparisonPolicy",
    "captureRunner",
    "comparisonRunner",
    "targets",
    "referenceSets",
    "stateSetups",
    "caseDimensions",
    "expectedActualCount",
    "expectedReferenceCount",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "profileId": { "type": "string", "minLength": 1 },
    "componentModelId": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["contract-only", "single-target-active", "matrix-active"]
    },
    "rendererSuiteIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "fixture": { "$ref": "#/$defs/fixture" },
    "environment": { "$ref": "#/$defs/environment" },
    "imageNormalization": { "$ref": "#/$defs/imageNormalization" },
    "comparisonPolicy": { "$ref": "#/$defs/comparisonPolicy" },
    "captureRunner": { "$ref": "#/$defs/captureRunner" },
    "comparisonRunner": { "$ref": "#/$defs/comparisonRunner" },
    "targets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/target" }
    },
    "referenceSets": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/referenceSet" }
    },
    "stateSetups": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/stateSetup" }
    },
    "caseDimensions": { "$ref": "#/$defs/caseDimensions" },
    "expectedActualCount": { "type": "integer", "minimum": 1 },
    "expectedReferenceCount": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "density", "content", "label"],
      "properties": {
        "size": { "const": "small" },
        "density": { "const": "default" },
        "content": { "const": "label-only" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "seedColor",
        "contrastMode",
        "colorBackend",
        "applicationStyle",
        "locale",
        "timeZone",
        "layoutDirection",
        "qpaPlatform",
        "devicePixelRatio",
        "logicalDpiX",
        "logicalDpiY",
        "animation",
        "runtimeFingerprint"
      ],
      "properties": {
        "seedColor": { "const": "#6750A4" },
        "contrastMode": { "const": "standard" },
        "colorBackend": { "const": "force-fallback" },
        "applicationStyle": { "const": "Fusion" },
        "locale": { "const": "C" },
        "timeZone": { "const": "UTC" },
        "layoutDirection": { "const": "left-to-right" },
        "qpaPlatform": { "const": "offscreen" },
        "devicePixelRatio": { "const": 1.0 },
        "logicalDpiX": { "const": 96.0 },
        "logicalDpiY": { "const": 96.0 },
        "animation": { "$ref": "#/$defs/animation" },
        "runtimeFingerprint": { "$ref": "#/$defs/runtimeFingerprint" }
      }
    },
    "animation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["driver", "wallClockAllowed", "eventLoopWaitAllowed"],
      "properties": {
        "driver": { "const": "direct-test-controller" },
        "wallClockAllowed": { "const": false },
        "eventLoopWaitAllowed": { "const": false }
      }
    },
    "runtimeFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "algorithm", "fields"],
      "properties": {
        "required": { "const": true },
        "algorithm": { "const": "sha256" },
        "fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "imageNormalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logicalCanvas",
        "widgetRect",
        "backgroundColorRole",
        "encoder",
        "pixelFormat",
        "alphaMode",
        "colorSpace",
        "origin",
        "metadataPolicy"
      ],
      "properties": {
        "logicalCanvas": { "$ref": "#/$defs/size" },
        "widgetRect": { "$ref": "#/$defs/rect" },
        "backgroundColorRole": { "const": "Surface" },
        "encoder": { "const": "png" },
        "pixelFormat": { "const": "RGBA8888" },
        "alphaMode": { "const": "straight" },
        "colorSpace": { "const": "sRGB" },
        "origin": { "const": "top-left" },
        "metadataPolicy": { "const": "strip-all" }
      }
    },
    "size": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width", "height"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "rect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "width", "height"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "acceptance",
        "pixel",
        "ssim",
        "missingReference",
        "unexpectedReference",
        "dimensionMismatch",
        "environmentMismatch",
        "masksAllowed",
        "runtimeToleranceOverridesAllowed",
        "inTestReferenceUpdatesAllowed",
        "crossTargetReferenceSubstitutionAllowed"
      ],
      "properties": {
        "acceptance": { "const": "all-metrics" },
        "pixel": { "$ref": "#/$defs/pixelPolicy" },
        "ssim": { "$ref": "#/$defs/ssimPolicy" },
        "missingReference": { "const": "fail" },
        "unexpectedReference": { "const": "fail" },
        "dimensionMismatch": { "const": "fail" },
        "environmentMismatch": { "const": "fail" },
        "masksAllowed": { "const": false },
        "runtimeToleranceOverridesAllowed": { "const": false },
        "inTestReferenceUpdatesAllowed": { "const": false },
        "crossTargetReferenceSubstitutionAllowed": { "const": false }
      }
    },
    "captureRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "executable",
        "mode",
        "manifestPath",
        "actualPathTemplate",
        "requiresEmptyOutputDirectory",
        "referenceWritesAllowed",
        "runtimeValidation"
      ],
      "properties": {
        "status": { "const": "source-implemented" },
        "executable": { "const": "qtmaterial3_material_button_capture" },
        "mode": { "const": "actual-only" },
        "manifestPath": { "const": "manifest.json" },
        "actualPathTemplate": {
          "const": "actual/{componentId}/{state}/{theme}.png"
        },
        "requiresEmptyOutputDirectory": { "const": true },
        "referenceWritesAllowed": { "const": false },
        "runtimeValidation": { "const": "fail-closed" }
      }
    },
    "comparisonRunner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "executable",
        "mode",
        "referenceManifestPath",
        "reportPath",
        "failureArtifactPathTemplate",
        "requiresEmptyArtifactDirectory",
        "referenceWritesAllowed",
        "runtimeOverridesAllowed"
      ],
      "properties": {
        "status": { "const": "source-implemented" },
        "executable": { "const": "tools/compare_material_visual_capture.py" },
        "mode": { "const": "compare-only" },
        "referenceManifestPath": { "const": "manifest.json" },
        "reportPath": { "const": "comparison-report.json" },
        "failureArtifactPathTemplate": {
          "const": "failures/{componentId}/{state}/{theme}/{kind}.{extension}"
        },
        "requiresEmptyArtifactDirectory": { "const": true },
        "referenceWritesAllowed": { "const": false },
        "runtimeOverridesAllowed": { "const": false }
      }
    },
    "pixelPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxDifferentPixels", "maxChannelDelta"],
      "properties": {
        "maxDifferentPixels": { "const": 0 },
        "maxChannelDelta": { "const": 0 }
      }
    },
    "ssimPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "windowSize",
        "channelModel",
        "windowTraversal",
        "edgePolicy",
        "covariance",
        "dynamicRange",
        "k1",
        "k2"
      ],
      "properties": {
        "minimum": { "const": 1.0 },
        "windowSize": { "const": 8 },
        "channelModel": { "const": "rgba-independent" },
        "windowTraversal": { "const": "non-overlapping" },
        "edgePolicy": { "const": "require-exact-tiles" },
        "covariance": { "const": "population" },
        "dynamicRange": { "const": 255 },
        "k1": { "const": 0.01 },
        "k2": { "const": 0.03 }
      }
    },
    "referenceSet": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "status", "manifestPath"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pending", "reviewed"] },
        "manifestPath": { "type": "string", "minLength": 1 }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operatingSystem",
        "runnerImage",
        "architecture",
        "qtVersion",
        "qtMajor",
        "compiler",
        "font",
        "referenceRoot"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "operatingSystem": { "enum": ["windows", "linux", "macos"] },
        "runnerImage": { "type": "string", "minLength": 1 },
        "architecture": { "const": "x86_64" },
        "qtVersion": {
          "type": "string",
          "pattern": "^[56]\\.[0-9]+\\.[0-9]+$"
        },
        "qtMajor": { "enum": [5, 6] },
        "compiler": { "type": "string", "minLength": 1 },
        "font": { "$ref": "#/$defs/font" },
        "referenceRoot": { "type": "string", "minLength": 1 }
      }
    },
    "font": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family",
        "pointSize",
        "exactMatchRequired",
        "faceFingerprintRequired",
        "substitutionsAllowed",
        "hintingPreference"
      ],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "pointSize": { "const": 14 },
        "exactMatchRequired": { "const": true },
        "faceFingerprintRequired": { "const": true },
        "substitutionsAllowed": { "const": false },
        "hintingPreference": { "const": "prefer-no-hinting" }
      }
    },
    "stateSetup": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "enabled",
        "hovered",
        "focused",
        "pressed",
        "stateLayerProgress",
        "feedback"
      ],
      "properties": {
        "id": {
          "enum": ["enabled", "disabled", "hovered", "focused", "pressed"]
        },
        "enabled": { "type": "boolean" },
        "hovered": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "pressed": { "type": "boolean" },
        "stateLayerProgress": { "type": "number", "minimum": 0 },
        "feedback": { "$ref": "#/$defs/feedback" }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "progress", "origin"],
      "properties": {
        "kind": { "enum": ["none", "state-layer", "ripple"] },
        "progress": { "type": "number", "minimum": 0 },
        "origin": { "$ref": "#/$defs/normalizedPoint" }
      }
    },
    "normalizedPoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalizedX", "normalizedY"],
      "properties": {
        "normalizedX": { "type": "number", "minimum": 0 },
        "normalizedY": { "type": "number", "minimum": 0 }
      }
    },
    "caseDimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components", "states", "themes", "targets"],
      "properties": {
        "components": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": ["enabled", "disabled", "hovered", "focused", "pressed"]
          }
        },
        "themes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["light", "dark"] }
        },
        "targets": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "rendererSuiteId",
        "state",
        "stateSetupId",
        "theme",
        "actualPath",
        "references"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "rendererSuiteId": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["enabled", "disabled", "hovered", "focused", "pressed"]
        },
        "stateSetupId": {
          "enum": ["enabled", "disabled", "hovered", "focused", "pressed"]
        },
        "theme": { "enum": ["light", "dark"] },
        "actualPath": { "type": "string", "minLength": 1 },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/reference" }
        }
      }
    },
    "reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targetId", "path"],
      "properties": {
        "targetId": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 }
      }
    }
  }
}

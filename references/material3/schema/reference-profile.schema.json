{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/material-reference-profile/v1",
  "title": "QtMaterial3 Material reference profile",
  "description": "Versioned provenance and comparison policy for one independent Material reference track.",
  "x-qtm3-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "materialProfile",
    "referenceVersion",
    "stability",
    "releaseDate",
    "retrievedAt",
    "sourcePrecedence",
    "sources",
    "comparisonPolicy"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^m3-[a-z0-9.-]+$"
    },
    "materialProfile": {
      "enum": [
        "classic",
        "expressive"
      ]
    },
    "referenceVersion": {
      "type": "string",
      "minLength": 1
    },
    "stability": {
      "enum": [
        "stable",
        "experimental"
      ]
    },
    "releaseDate": {
      "type": "string",
      "format": "date"
    },
    "retrievedAt": {
      "type": "string",
      "format": "date"
    },
    "sourcePrecedence": {
      "const": [
        "material-guideline",
        "androidx-implementation",
        "androidx-release-notes"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 3,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "comparisonPolicy": {
      "$ref": "#/$defs/comparisonPolicy"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "title",
        "uri"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
        },
        "kind": {
          "enum": [
            "material-guideline",
            "androidx-implementation",
            "androidx-release-notes"
          ]
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "uri": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "artifact": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+:[A-Za-z0-9_.-]+$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "releaseDate": {
          "type": "string",
          "format": "date"
        },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "androidx-implementation",
                  "androidx-release-notes"
                ]
              }
            }
          },
          "then": {
            "required": [
              "artifact",
              "version",
              "releaseDate"
            ]
          }
        }
      ]
    },
    "comparisonPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classifications",
        "domains",
        "defaultGeometryToleranceDp",
        "defaultColorMetric",
        "typographyRasterPolicy"
      ],
      "properties": {
        "classifications": {
          "const": [
            "MUST_MATCH",
            "PLATFORM_ADAPTATION",
            "QTMATERIAL_EXTENSION"
          ]
        },
        "domains": {
          "const": [
            "geometry",
            "tokens",
            "colors",
            "typography",
            "states",
            "motion",
            "accessibility",
            "behavior"
          ]
        },
        "defaultGeometryToleranceDp": {
          "type": "number",
          "minimum": 0
        },
        "defaultColorMetric": {
          "enum": [
            "semantic-token",
            "deltaE2000",
            "exact"
          ]
        },
        "typographyRasterPolicy": {
          "const": "spec-not-glyph-pixels"
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/material-reference-component/v1",
  "title": "QtMaterial3 Material component reference model",
  "description": "Machine-readable component family, variants, slots, states, token roles, behavior and Qt ResolvedSpec binding.",
  "x-qtm3-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profileId",
    "status",
    "family",
    "anchorComponentId",
    "sourceRefs",
    "variants",
    "slots",
    "states",
    "tokenRoles",
    "behaviors",
    "qtBinding"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "profileId": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "seeded",
        "evidence-backed"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "anchorComponentId": {
      "type": "string",
      "minLength": 1
    },
    "sourceRefs": {
      "$ref": "#/$defs/sourceRefs"
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/variant"
      }
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slot"
      }
    },
    "states": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/state"
      }
    },
    "tokenRoles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/tokenRole"
      }
    },
    "behaviors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/behavior"
      }
    },
    "qtBinding": {
      "$ref": "#/$defs/qtBinding"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sourceRefs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "classification": {
      "enum": [
        "MUST_MATCH",
        "PLATFORM_ADAPTATION",
        "QTMATERIAL_EXTENSION"
      ]
    },
    "variantIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "variant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "materialName",
        "required",
        "classification",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "componentId": {
          "type": "string",
          "minLength": 1
        },
        "materialName": {
          "type": "string",
          "minLength": 1
        },
        "required": {
          "type": "boolean"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "cardinality",
        "variants",
        "classification",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "cardinality": {
          "enum": [
            "exactly-one",
            "zero-or-one",
            "one-or-more"
          ]
        },
        "variants": {
          "$ref": "#/$defs/variantIds"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required",
        "classification",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "enum": [
            "enabled",
            "disabled",
            "hovered",
            "focused",
            "pressed",
            "dragged",
            "selected",
            "unselected"
          ]
        },
        "required": {
          "type": "boolean"
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "tokenRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "domain",
        "classification",
        "variants",
        "resolvedSpecPaths",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "domain": {
          "enum": [
            "geometry",
            "tokens",
            "colors",
            "typography",
            "states",
            "motion",
            "accessibility",
            "behavior"
          ]
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "variants": {
          "$ref": "#/$defs/variantIds"
        },
        "resolvedSpecPaths": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "behavior": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "classification",
        "when",
        "expected",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "classification": {
          "$ref": "#/$defs/classification"
        },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "state",
            "trigger"
          ],
          "properties": {
            "state": {
              "type": "string",
              "minLength": 1
            },
            "trigger": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "expected": {
          "type": "string",
          "minLength": 1
        },
        "sourceRefs": {
          "$ref": "#/$defs/sourceRefs"
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "qtBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resolvedSpecHeader",
        "resolvedSpecType",
        "runtimeSupportFields"
      ],
      "properties": {
        "resolvedSpecHeader": {
          "type": "string",
          "pattern": "^include/qtmaterial/specs/.+\\.h$"
        },
        "resolvedSpecType": {
          "type": "string",
          "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
        },
        "runtimeSupportFields": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          }
        }
      }
    }
  }
}

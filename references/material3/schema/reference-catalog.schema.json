{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/material-reference-catalog/v1",
  "title": "QtMaterial3 Material reference catalog",
  "description": "Authoritative index of active reference profiles, component models, suites and visual contracts.",
  "x-qtm3-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "profiles",
    "components",
    "suites",
    "visualContracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "profiles": {
      "type": "array",
      "minItems": 2,
      "items": {
        "$ref": "#/$defs/profileEntry"
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/componentEntry"
      }
    },
    "suites": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/suiteEntry"
      }
    },
    "visualContracts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/visualContractEntry"
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)*$"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(classic|expressive)/"
    },
    "status": {
      "enum": [
        "seeded",
        "evidence-backed"
      ]
    },
    "profileEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "profile",
        "stability"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "profile": {
          "enum": [
            "classic",
            "expressive"
          ]
        },
        "stability": {
          "enum": [
            "stable",
            "experimental"
          ]
        }
      }
    },
    "componentEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "profileId",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "suiteEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "profileId",
        "componentModelId",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "componentModelId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "visualContractEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "profileId",
        "componentModelId",
        "status"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "profileId": {
          "$ref": "#/$defs/id"
        },
        "componentModelId": {
          "$ref": "#/$defs/id"
        },
        "status": {
          "enum": ["contract-only", "single-target-active", "matrix-active"]
        }
      }
    }
  }
}

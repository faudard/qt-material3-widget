{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qt-material3-widget.dev/schemas/material-conformance-report.schema.json",
  "x-qtm3-schemaVersion": 1,
  "title": "Qt Material 3 conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "profileId",
    "componentModelId",
    "status",
    "generatedBy",
    "gates",
    "summary",
    "components"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "const": "classic.buttons.conformance" },
    "profileId": { "type": "string", "minLength": 1 },
    "componentModelId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["complete", "incomplete", "failed"] },
    "generatedBy": {
      "const": "tools/generate_material_conformance_report.py"
    },
    "gates": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/gate" }
    },
    "summary": { "$ref": "#/$defs/summary" },
    "components": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/component" }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "checkerPath", "status", "errorCount", "errors"],
      "properties": {
        "id": {
          "enum": [
            "reference-model",
            "structural-conformance",
            "renderer-conformance",
            "visual-contract"
          ]
        },
        "checkerPath": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "fail"] },
        "errorCount": { "type": "integer", "minimum": 0 },
        "errors": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentCount",
        "modeledCount",
        "fullyConformantCount",
        "incompleteCount",
        "notModeledCount",
        "failedCount",
        "headlinePassCounts"
      ],
      "properties": {
        "componentCount": { "type": "integer", "minimum": 0 },
        "modeledCount": { "type": "integer", "minimum": 0 },
        "fullyConformantCount": { "type": "integer", "minimum": 0 },
        "incompleteCount": { "type": "integer", "minimum": 0 },
        "notModeledCount": { "type": "integer", "minimum": 0 },
        "failedCount": { "type": "integer", "minimum": 0 },
        "headlinePassCounts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structure", "tokens", "states", "rendering"],
          "properties": {
            "structure": { "type": "integer", "minimum": 0 },
            "tokens": { "type": "integer", "minimum": 0 },
            "states": { "type": "integer", "minimum": 0 },
            "rendering": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "dimensionStatus": {
      "enum": ["pass", "fail", "pending-runtime", "not-evaluated", "not-modeled"]
    },
    "reason": {
      "enum": [
        "verified-static",
        "verified-runtime",
        "gate-failed",
        "no-reference-model",
        "no-evidence-suite",
        "incomplete-evidence",
        "awaiting-reviewed-reference",
        "runtime-comparison-not-ingested"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "sourceIds",
        "caseCount",
        "assertionCount",
        "stateCount",
        "themeCount",
        "targetCount",
        "passedTargetCount"
      ],
      "properties": {
        "status": { "$ref": "#/$defs/dimensionStatus" },
        "reason": { "$ref": "#/$defs/reason" },
        "sourceIds": {
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "caseCount": { "type": "integer", "minimum": 0 },
        "assertionCount": { "type": "integer", "minimum": 0 },
        "stateCount": { "type": "integer", "minimum": 0 },
        "themeCount": { "type": "integer", "minimum": 0 },
        "targetCount": { "type": "integer", "minimum": 0 },
        "passedTargetCount": { "type": "integer", "minimum": 0 }
      }
    },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["structure", "tokens", "states", "rendering"],
      "properties": {
        "structure": { "$ref": "#/$defs/dimensionStatus" },
        "tokens": { "$ref": "#/$defs/dimensionStatus" },
        "states": { "$ref": "#/$defs/dimensionStatus" },
        "rendering": { "$ref": "#/$defs/dimensionStatus" }
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "structure",
        "tokens",
        "states",
        "semanticRendering",
        "visualRendering"
      ],
      "properties": {
        "structure": { "$ref": "#/$defs/evidence" },
        "tokens": { "$ref": "#/$defs/evidence" },
        "states": { "$ref": "#/$defs/evidence" },
        "semanticRendering": { "$ref": "#/$defs/evidence" },
        "visualRendering": { "$ref": "#/$defs/evidence" }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "componentId",
        "name",
        "family",
        "modelStatus",
        "profileId",
        "componentModelId",
        "headline",
        "dimensions",
        "overallStatus"
      ],
      "properties": {
        "componentId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "minLength": 1 },
        "modelStatus": { "enum": ["modeled", "not-modeled", "failed"] },
        "profileId": { "type": "string" },
        "componentModelId": { "type": "string" },
        "headline": { "$ref": "#/$defs/headline" },
        "dimensions": { "$ref": "#/$defs/dimensions" },
        "overallStatus": { "enum": ["pass", "fail", "incomplete", "not-modeled"] }
      }
    }
  }
}

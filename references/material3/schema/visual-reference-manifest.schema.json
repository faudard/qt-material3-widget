{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://qtm3.dev/schemas/material-visual-reference-manifest/v1",
  "title": "QtMaterial3 Material visual reference manifest",
  "description": "Closed inventory promoted from one reviewed deterministic Material capture.",
  "x-qtm3-schemaVersion": 1,
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "contractId",
    "contractSha256",
    "targetId",
    "referenceMode",
    "sourceCaptureManifestSha256",
    "runtimeFingerprint",
    "caseCount",
    "cases"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "contractId": { "type": "string", "minLength": 1 },
    "contractSha256": { "$ref": "#/$defs/sha256" },
    "targetId": { "type": "string", "minLength": 1 },
    "referenceMode": { "const": "reviewed" },
    "sourceCaptureManifestSha256": { "$ref": "#/$defs/sha256" },
    "runtimeFingerprint": { "$ref": "#/$defs/runtimeFingerprint" },
    "caseCount": { "type": "integer", "minimum": 1 },
    "cases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "runtimeFingerprint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest", "values"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/sha256" },
        "values": { "$ref": "#/$defs/runtimeValues" }
      }
    },
    "runtimeValues": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner-image",
        "operating-system",
        "operating-system-version",
        "architecture",
        "qt-version",
        "qt-build-abi",
        "compiler",
        "qpa-platform",
        "application-style",
        "font-family",
        "font-face-sha256",
        "font-style",
        "font-weight",
        "font-point-size",
        "device-pixel-ratio",
        "logical-dpi-x",
        "logical-dpi-y"
      ],
      "properties": {
        "runner-image": { "type": "string", "minLength": 1 },
        "operating-system": { "enum": ["windows", "linux", "macos"] },
        "operating-system-version": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 },
        "qt-version": { "type": "string", "minLength": 1 },
        "qt-build-abi": { "type": "string", "minLength": 1 },
        "compiler": { "type": "string", "minLength": 1 },
        "qpa-platform": { "type": "string", "minLength": 1 },
        "application-style": { "type": "string", "minLength": 1 },
        "font-family": { "type": "string", "minLength": 1 },
        "font-face-sha256": { "$ref": "#/$defs/sha256" },
        "font-style": { "type": "string", "minLength": 1 },
        "font-weight": { "type": "integer", "minimum": 0 },
        "font-point-size": { "type": "number", "minimum": 1 },
        "device-pixel-ratio": { "type": "number", "minimum": 1 },
        "logical-dpi-x": { "type": "number", "minimum": 1 },
        "logical-dpi-y": { "type": "number", "minimum": 1 }
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "componentId",
        "state",
        "theme",
        "referencePath",
        "width",
        "height",
        "pixelSha256"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "componentId": { "type": "string", "minLength": 1 },
        "state": {
          "enum": ["enabled", "disabled", "hovered", "focused", "pressed"]
        },
        "theme": { "enum": ["light", "dark"] },
        "referencePath": { "type": "string", "minLength": 1 },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "pixelSha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
